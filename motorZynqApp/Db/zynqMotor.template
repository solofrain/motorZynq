    field(ONST, "1/2 step")
    field(ONVL, "1")
    field(TWST, "1/4 step")
    field(TWVL, "2")
    field(THST, "1/8 step")
    field(THVL, "3")
    field(FRST, "1/16 step")
    field(FRVL, "4")
    field(FVST, "1/32 step")
    field(FVVL, "5")
    field(SXST, "1/128 step")
    field(SXVL, "7")
    field(SVST, "1/256 step")
    field(SVVL, "8")
    field(EIST, "NC 1/2 step")
